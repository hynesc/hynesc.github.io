---
interface Props {
  cells: number[][];
  label: string;
}
const { cells, label } = Astro.props;
const colors = [
  '#111111',
  '#2563c4',
  '#db4134',
  '#64bd48',
  '#f5d941',
  '#999999',
  '#cf3eb0',
  '#ed8d2d',
  '#8bd3ec',
  '#813647',
];
---

<svg
  class="arc-grid"
  viewBox={`0 0 ${cells[0].length} ${cells.length}`}
  role="img"
  aria-label={label}
>
  {cells.map((row, y) =>
    row.map((color, x) => (
      <rect
        x={x}
        y={y}
        width="1"
        height="1"
        fill={colors[color]}
        stroke="#777"
        stroke-width="0.035"
      />
    )),
  )}
</svg>

<style>
  .arc-grid {
    display: block;
    width: 100%;
    max-width: 12rem;
    max-height: 16rem;
    margin: 1rem auto;
  }
</style>
