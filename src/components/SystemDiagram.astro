---
interface Props {
  kind: 'multi' | 'signal';
  id: string;
}
const { kind, id } = Astro.props;
---

<div
  class:list={['system-diagram', `diagram-${kind}`]}
  role="img"
  aria-labelledby={`${id}-title ${id}-desc`}
>
  <span class="sr-only" id={`${id}-title`}>
    {kind === 'multi' ? 'Best-of-N response selection' : 'Signal Assistant architecture'}
  </span>
  <span class="sr-only" id={`${id}-desc`}>
    {kind === 'multi'
      ? 'A chat request fans out to three candidate generations. A judge selects a response; a deterministic fallback handles invalid judge output.'
      : 'Signal messages pass through Signal CLI, a router, and per-chat conversation state to local Ollama inference. Replies return through the same transport.'}
  </span>
  <div class="diagram-flow" aria-hidden="true">
    {kind === 'multi' ? (
      <>
        <span class="diagram-node">Request</span>
        <div class="diagram-candidates diagram-step">
          {['A', 'B', 'C'].map((model) => (
            <span class="diagram-node">Model {model}</span>
          ))}
        </div>
        <span class="diagram-node diagram-step diagram-accent">Judge</span>
        <span class="diagram-result diagram-step">✓</span>
      </>
    ) : (
      <>
        <span class="diagram-node">Signal CLI</span>
        <span class="diagram-node diagram-step">Router</span>
        <span class="diagram-node diagram-step">Chat state</span>
        <span class="diagram-node diagram-step diagram-accent">Local LLM</span>
      </>
    )}
  </div>
  <p class="diagram-note" aria-hidden="true">
    {kind === 'multi'
      ? 'Concurrent generation · fallback if needed'
      : 'Per-chat memory · replies via Signal CLI'}
  </p>
</div>
