---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
const roles = [
  {
    date: 'Jun–Sep 2023',
    title: 'Data Analyst Intern',
    org: 'GreyNoise Intelligence',
    area: 'Finance & Operations · Washington, DC',
    points: [
      'Analyzed customer churn and lead origins in R to investigate drivers of retention and conversion.',
      'Automated data-quality checks, NAICS classification, and vendor/transaction reporting in Excel.',
      'Built models for contract changes and an investment tracker to forecast monthly returns.',
      'Created an interactive Streamlit dashboard to communicate churn and conversion analysis.',
    ],
    link: '/projects/gn-churn/',
    label: 'Related project: customer-retention analysis',
  },
  {
    date: 'May–Oct 2021',
    title: 'Undergraduate Research Assistant',
    org: 'Darla Moore School of Business',
    area: 'Division of Research · University of South Carolina',
    points: [
      'Cleaned and analyzed MSA-level economic, social, and demographic data to study STEM-worker agglomeration.',
      'Calculated location quotients and ran regressions in Stata and R to examine geographic clustering.',
      'Reviewed literature on spatial segregation and neighborhood effects; adapted course materials for accessibility.',
    ],
  },
  {
    date: 'Jan 2020–Jan 2021',
    title: 'Undergraduate Research Assistant',
    org: 'University of South Carolina',
    area: 'Department of Economics',
    points: [
      'Digitized and organized CDC vital statistics data to support research into racial disparities in birth outcomes following hospital desegregation.',
    ],
  },
];
---

<Base
  title="Experience & education"
  active="Experience"
  description="Christopher Hynes’s research and industry experience, education, technical capabilities, and academic honors."
>
  <section class="page-intro shell">
    <p class="eyebrow">Experience / Education / Capabilities</p>
    <h1>
      Experience &
      <br />
      <em>education.</em>
    </h1>
    <p class="page-deck">
      Experience across academic research, business analytics,
      <br class="desktop-break" /> and graduate computer science.
    </p>
    <a class="text-link" href="/assets/resume.pdf">
      Download my résumé <Arrow diagonal />
    </a>
    <nav class="section-links" aria-label="Experience page sections">
      <a href="#research-experience">Research & industry</a>
      <a href="#education">Education</a>
      <a href="#skills">Skills</a>
      <a href="#honors">Honors</a>
    </nav>
  </section>
  <section class="experience-section shell" id="research-experience">
    <h2 class="section-label">Research & industry</h2>
    <div>
      {roles.map((r) => (
        <article class="experience-row">
          <span class="eyebrow">{r.date}</span>
          <div>
            <h3>{r.title}</h3>
            <p class="role-org">{r.org}</p>
            <p class="small-note">{r.area}</p>
            <ul>
              {r.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            {r.link && (
              <a class="text-link" href={r.link}>
                {r.label}
                <Arrow />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="experience-section shell" id="education">
    <h2 class="section-label">Education</h2>
    <div>
      <article class="experience-row">
        <span class="eyebrow">
          2024–2026
          <br />
          Expected Dec. 2026
        </span>
        <div>
          <h3>Georgia Institute of Technology</h3>
          <p class="role-org">M.S. Computer Science · GPA 4.0</p>
          <p>
            Graduate work in machine learning, health informatics, NLP, robotics, algorithms, and
            human–computer interaction. Four ML studies covered supervised and unsupervised
            learning, randomized optimization, and reinforcement learning on datasets with up to 7.7
            million records.
          </p>
        </div>
      </article>
      <article class="experience-row">
        <span class="eyebrow">2018–2022</span>
        <div>
          <h3>University of South Carolina</h3>
          <p class="role-org">B.S. Statistics & Economics · Honors College</p>
          <p>
            Summa cum laude · GPA 4.0. Honors thesis applying synthetic control to Chile’s economic
            reforms. Coursework included econometrics, labor economics, development economics, and
            urban economics. Study abroad at Universidad Carlos III de Madrid, 2021–2022.
          </p>
        </div>
      </article>
    </div>
  </section>
  <section class="capabilities-section shell" id="skills">
    <p class="eyebrow">Technical skills</p>
    <h2>
      Methods, languages, and <em>tools.</em>
    </h2>
    <div class="capabilities-grid">
      <div>
        <h3>Research & evaluation</h3>
        <p>
          Statistical inference, causal inference, synthetic control, experimental comparison,
          robustness checks, repeated trials, model selection, and quantitative user research.
        </p>
      </div>
      <div>
        <h3>Data & machine learning</h3>
        <p>
          Python, R, SQL, PyTorch, scikit-learn, TensorFlow, Hugging Face Transformers, pandas,
          NumPy, and tidyverse. NLP, predictive modeling, and reinforcement learning.
        </p>
        <p>Additional familiarity: Java, Stata, SAS, and PySpark.</p>
      </div>
      <div>
        <h3>Systems & communication</h3>
        <p>
          FastAPI, asyncio, Docker, Linux, Git, GitHub Actions, Streamlit, Excel, Figma, technical
          reports, and data visualization.
        </p>
      </div>
    </div>
  </section>
  <section class="honors-section shell" id="honors">
    <h2>Selected honors</h2>
    <div>
      <p>
        <strong>Stephen D. Durham Award</strong>
        <span>Top senior statistics student · 2022</span>
      </p>
      <p>
        <strong>Phi Beta Kappa</strong>
        <span>2022</span>
      </p>
      <p>
        <strong>Palmetto Fellows & Presidential Scholars</strong>
        <span>2018–2022</span>
      </p>
    </div>
  </section>
</Base>

<style>
  .section-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 28px;
    font-size: 12px;
    color: var(--green);
  }
  .section-links a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--line);
    padding-block: 5px;
  }
  .section-links a:hover {
    text-decoration-color: currentColor;
  }
</style>
