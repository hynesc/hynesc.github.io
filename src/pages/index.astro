---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ResultsFigure from '../components/ResultsFigure.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import { getCollection } from 'astro:content';
import { trialCount } from '../data/readmission';
const projects = await getCollection('projects');
function featured(id: string) {
  const project = projects.find((project) => project.id === id);
  if (!project?.data.home) throw new Error(`Missing homepage metadata for ${id}`);
  return {
    ...project.data,
    home: { ...project.data.home, title: project.data.home.title ?? project.data.title },
    href: `/projects/${project.id}/`,
  };
}
const readmission = featured('readmission-prediction');
const chile = featured('chile-neoliberal-reforms');
const ux = featured('ios-camera-prototype');
const churn = featured('gn-churn');
const systems = [
  { project: featured('multi-llm'), kind: 'multi' as const },
  { project: featured('signal-assistant'), kind: 'signal' as const },
];
---

<Base>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-kicker">
      <div class="hero-identity">
        <p class="hero-name">Christopher Hynes</p>
        <p class="hero-degree">
          M.S. Computer Science, Georgia Tech <span>· Expected December 2026</span>
        </p>
      </div>
      <span class="edition">Statistics / Economics / Computer science</span>
    </div>
    <div class="hero-grid">
      <h1 id="hero-title">
        Empirical
        <br />
        <em>research.</em>
        <br />
        Working systems<span class="rust">.</span>
      </h1>
      <div class="hero-aside">
        <svg class="research-mark" viewBox="0 0 220 160" fill="none" aria-hidden="true">
          <ellipse cx="110" cy="80" rx="87" ry="48" transform="rotate(-35 110 80)" />
          <ellipse cx="110" cy="80" rx="87" ry="48" transform="rotate(35 110 80)" />
          <path d="M18 80h184M110 12v136" class="mark-guide" />
          <circle cx="110" cy="80" r="7" />
          <circle cx="47" cy="43" r="4" />
          <circle cx="174" cy="117" r="4" />
        </svg>
        <p>
          I bring statistics, economics, and computer science to questions about models, policies,
          and human behavior—and build tools to investigate them.
        </p>
        <a class="text-link" href="/about.html">
          A little more about me <Arrow />
        </a>
      </div>
    </div>
    <div class="hero-bottom">
      <div class="hero-actions">
        <a class="button" href="#selected-work">
          Explore the work <span aria-hidden="true">↓</span>
        </a>
        <a class="button button-secondary" href="/assets/resume.pdf">
          Résumé <Arrow diagonal />
        </a>
      </div>
      <div class="hero-experience">
        <span class="eyebrow">Research & industry</span>
        <a href="/experience.html">
          <span class="experience-role">Research assistant, USC</span>
          <span aria-hidden="true"> · </span>
          <span class="experience-role">
            Data analyst intern, GreyNoise <Arrow diagonal />
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="selected-section shell" id="selected-work" aria-labelledby="selected-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Selected research</p>
        <h2 id="selected-title">
          Empirical <em>research.</em>
        </h2>
      </div>
      <p>
        Studies in machine learning, economics,
        <br class="desktop-break" /> and human–computer interaction.
      </p>
    </div>
    <article class="flagship">
      <div class="flagship-copy">
        <div class="project-meta">
          <span>{readmission.home.label}</span>
          <span>{readmission.date.slice(0, 4)}</span>
        </div>
        <h3>
          <a href={readmission.href}>{readmission.home.title}</a>
        </h3>
        <p>{readmission.home.summary}</p>
        <div class="flagship-stat">
          <span>{trialCount}</span>
          <p>
            trials per configuration
            <br />
            using synthetic patient data
          </p>
        </div>
        <a class="text-link light" href={readmission.href}>
          {readmission.home.linkLabel} <Arrow />
        </a>
      </div>
      <ResultsFigure id="home-results" compact />
    </article>
    <div class="research-pair">
      <article class="research-card">
        <a class="project-visual thesis-visual" href={chile.href}>
          <span class="visual-label">Observed / Counterfactual</span>
          <img
            src="/projects/chile-neoliberal-reforms/thumbnail.png"
            width="763"
            height="519"
            alt="Original thesis figure: observed Chilean GDP per capita diverges above its synthetic control after 1990."
            loading="lazy"
          />
          <span class="visual-foot">Chile, 1960–2019 · Original thesis figure</span>
        </a>
        <div class="project-meta">
          <span>{chile.home.label}</span>
          <span>{chile.date.slice(0, 4)}</span>
        </div>
        <h3>
          <a href={chile.href}>
            {chile.home.title} <Arrow diagonal />
          </a>
        </h3>
        <p>{chile.home.summary}</p>
        <a class="text-link" href={chile.href}>
          {chile.home.linkLabel} <Arrow />
        </a>
      </article>
      <article class="research-card">
        <a class="project-visual ux-visual" href={ux.href}>
          <div class="ux-annotation">
            <span class="visual-label">
              iOS camera
              <br />
              interface study
            </span>
            <span class="ux-quote">
              Camera-mode
              <br />
              <em>selection.</em>
            </span>
            <span class="visual-foot">Figma prototype · User evaluation</span>
          </div>
          <img
            src="/projects/ios-camera-prototype/thumbnail.png"
            width="393"
            height="852"
            alt="Original camera prototype with directly selectable modes arranged in a grid."
            loading="lazy"
          />
        </a>
        <div class="project-meta">
          <span>{ux.home.label}</span>
          <span>{ux.date.slice(0, 4)}</span>
        </div>
        <h3>
          <a href={ux.href}>
            {ux.home.title} <Arrow diagonal />
          </a>
        </h3>
        <p>{ux.home.summary}</p>
        <a class="text-link" href={ux.href}>
          {ux.home.linkLabel} <Arrow />
        </a>
      </article>
    </div>
    <a class="all-work-link" href="/projects.html">
      Explore all research & projects <Arrow />
    </a>
  </section>

  <section class="background-section shell" aria-labelledby="background-title">
    <div class="background-intro">
      <p class="eyebrow">02 / Background</p>
      <h2 id="background-title">
        Research &<br />
        <em>industry.</em>
      </h2>
      <p>
        I’ve worked in economics research and business analytics, and am completing graduate study
        in computer science.
      </p>
      <a class="text-link" href="/experience.html">
        Experience & education <Arrow />
      </a>
    </div>
    <div class="background-details">
      <div class="experience-preview">
        <div>
          <h3>GreyNoise Intelligence</h3>
          <p>Data analyst intern · Customer retention, lead conversion, and finance workflows.</p>
          <a class="text-link" href={churn.href}>
            {churn.home.linkLabel} <Arrow />
          </a>
          <p class="small-note">{churn.home.summary}</p>
        </div>
        <div>
          <h3>University of South Carolina</h3>
          <p>
            Research assistant · Economic geography, STEM-worker clustering, and public-health data.
          </p>
        </div>
      </div>
      <dl>
        <div>
          <dt>Georgia Tech</dt>
          <dd>M.S. Computer Science · Expected December 2026</dd>
        </div>
        <div>
          <dt>University of South Carolina</dt>
          <dd>B.S. Statistics & Economics · Honors · 2022</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="systems-section" aria-labelledby="systems-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / Working systems</p>
          <h2 id="systems-title">
            LLM applications
            <br />& <em>systems.</em>
          </h2>
        </div>
        <p>
          I build tools that connect models
          <br class="desktop-break" /> to practical, everyday use.
        </p>
      </div>
      <div class="systems-grid">
        {systems.map(({ project, kind }, i) => (
          <article class="system-card">
            <div class="project-meta">
              <span>
                {String(i + 1).padStart(2, '0')} / {project.shortTitle}
              </span>
              <span>{project.home.stack}</span>
            </div>
            <SystemDiagram kind={kind} id={`home-${kind}`} />
            <h3>
              <a href={project.href}>
                {project.home.title} <Arrow diagonal />
              </a>
            </h3>
            <p>{project.home.summary}</p>
            <a class="text-link light" href={project.href}>
              {project.home.linkLabel} <Arrow />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-kicker {
    align-items: center;
    gap: 24px;
  }
  .hero-name {
    font-size: 23px;
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .hero-degree {
    font-size: 11px;
    color: var(--muted);
    margin-top: 6px;
    line-height: 1.7;
  }
  .hero-degree span {
    white-space: nowrap;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    max-width: 100%;
    gap: 12px;
    flex-shrink: 0;
  }
  .button-secondary {
    background: transparent;
    color: var(--green);
    gap: 24px;
  }
  .button-secondary:hover {
    background: var(--soft);
  }
  .hero-experience {
    margin-left: auto;
    max-width: 470px;
  }
  .hero-experience .eyebrow {
    font-size: 9px;
  }
  .hero-experience > a {
    display: block;
    font-size: 11px;
    line-height: 1.7;
    margin-top: 5px;
  }
  .experience-role {
    white-space: nowrap;
  }
  .hero-experience > a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-experience :global(.arrow) {
    width: 12px;
    height: 12px;
    margin-left: 7px;
  }
  .background-section {
    border-top: 1px solid var(--line);
    padding-block: 55px 65px;
  }
  .background-intro > p:not(.eyebrow) {
    font-size: 14px;
    color: var(--muted);
    margin-top: 23px;
    max-width: 43ch;
  }
  .experience-preview {
    display: grid;
    gap: 22px;
  }
  .experience-preview h3 {
    font-size: 14px;
    font-weight: 550;
    line-height: 1.5;
  }
  .experience-preview p {
    font-size: 12px;
    color: var(--muted);
    margin-top: 5px;
    line-height: 1.7;
  }
  .experience-preview .text-link {
    font-size: 11px;
    margin-top: 9px;
    padding-block: 5px;
  }
  .experience-preview .small-note {
    font-size: 10px;
    margin-top: 9px;
  }
  .background-details dl {
    margin-top: 24px;
  }
  .selected-section {
    padding-bottom: 50px;
  }
  @media (max-width: 1100px) {
    .hero-kicker {
      align-items: start;
    }
    .edition {
      max-width: 210px;
      text-align: right;
    }
    .hero-bottom {
      gap: 24px;
    }
    .hero-experience {
      max-width: 350px;
    }
  }
  @media (max-width: 850px) {
    .hero-bottom {
      align-items: start;
      flex-wrap: wrap;
      gap: 20px;
    }
    .hero-experience {
      margin-left: 0;
      max-width: none;
    }
    .hero-name {
      font-size: 22px;
    }
    .hero-degree span {
      display: block;
    }
  }
  @media (max-width: 700px) {
    .hero {
      padding-top: 27px;
      padding-bottom: 32px;
    }
    .hero-name {
      font-size: 23px;
    }
    .hero-degree {
      font-size: 11px;
    }
    .hero-degree span {
      display: inline;
    }
    .hero-grid {
      margin-top: 23px;
    }
    .hero-aside {
      margin-top: 23px;
    }
    .hero-aside .text-link {
      margin-top: 10px;
    }
    .hero-bottom {
      margin-top: 24px;
      gap: 19px;
    }
    .hero-actions {
      gap: 10px;
    }
    .hero-actions .button {
      gap: 22px;
      padding: 13px 16px;
    }
    .hero-experience > a {
      font-size: 11px;
      max-width: 43ch;
    }
    .hero-experience .eyebrow {
      font-size: 8px;
    }
    .selected-section {
      padding-top: 30px;
      padding-bottom: 30px;
    }
    .research-pair {
      gap: 29px;
      margin-top: 28px;
    }
    .project-visual {
      height: 225px;
    }
    .thesis-visual {
      padding: 16px 20px;
    }
    .thesis-visual img {
      height: 165px;
    }
    .ux-visual {
      padding: 19px 24px;
    }
    .ux-visual img {
      height: 190px;
    }
    .ux-quote {
      font-size: 27px;
    }
    .ux-annotation .visual-foot {
      font-size: 7px;
      max-width: 145px;
    }
    .research-card h3 {
      font-size: 27px;
    }
    .all-work-link {
      margin-top: 26px;
    }
    .background-section {
      padding-block: 32px 37px;
      gap: 24px;
    }
    .background-section h2 {
      font-size: 37px;
    }
    .background-section h2 br {
      display: none;
    }
    .background-section h2 em::before {
      content: ' ';
      white-space: pre;
    }
    .background-intro > p:not(.eyebrow) {
      margin-top: 17px;
      font-size: 13px;
    }
    .background-section .text-link {
      margin-top: 13px;
    }
    .experience-preview {
      gap: 18px;
    }
    .experience-preview .text-link {
      margin-top: 6px;
    }
    .background-details dl {
      margin-top: 20px;
    }
    .background-details dl > div {
      padding-block: 10px;
    }
    .systems-section {
      padding-block: 34px;
    }
    .systems-grid {
      gap: 27px;
      margin-top: 24px;
    }
    .system-card :global(.system-diagram) {
      max-height: 130px;
      margin-block: 12px 16px;
    }
    .system-card h3 {
      font-size: 27px;
    }
    .system-card > p {
      font-size: 12px;
      margin-top: 12px;
    }
    .system-card .text-link {
      margin-top: 12px;
    }
  }
</style>
