---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="page-intro shell not-found">
    <p class="eyebrow">404 / An unexpected result</p>
    <h1>
      This path ends here.
      <br />
      <em>The work doesn’t.</em>
    </h1>
    <p class="page-deck">The page may have moved, or the address may be incomplete.</p>
    <a class="button" href="/projects.html">
      Explore the projects <span aria-hidden="true">→</span>
    </a>
    <a class="text-link" href="/">
      Return home
    </a>
  </section>
</Base>
