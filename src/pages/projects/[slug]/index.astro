---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Arrow from '../../../components/Arrow.astro';
import ResultsFigure from '../../../components/ResultsFigure.astro';
import SystemDiagram from '../../../components/SystemDiagram.astro';
export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, next } = Astro.props;
const { data, id } = project;
const { Content, headings } = await render(project);
---

<Base title={data.shortTitle} description={data.summary} active="Work">
  <article>
    <header class="case-header shell">
      <a class="back-link" href="/projects.html">
        ← All work
      </a>
      <p class="eyebrow">
        {data.categories.join(' / ')} · {data.date.slice(0, 4)}
      </p>
      <h1>{data.title}</h1>
      <p class="case-deck">{data.summary}</p>
      <ul class="tags">
        {data.methods.map((m) => (
          <li>{m}</li>
        ))}
      </ul>
      <div class="artifact-links">
        {data.artifacts.map((a) => (
          <a class="text-link" href={a.href}>
            {a.label}
            <Arrow diagonal />
          </a>
        ))}
      </div>
      {data.artifactNote && <p class="artifact-note">{data.artifactNote}</p>}
      {data.artifacts.some((a) => a.href.includes('.streamlit.app')) && (
        <p class="demo-note">
          The Streamlit demo may need to be woken after inactivity. Source code is available above.
        </p>
      )}
    </header>
    <div class="case-summary shell">
      <div>
        <p class="eyebrow">Context</p>
        <p>{data.context}</p>
      </div>
      <div>
        <p class="eyebrow">My contribution</p>
        <p>{data.contribution}</p>
      </div>
      <div>
        <p class="eyebrow">The takeaway</p>
        <p>{data.finding}</p>
      </div>
    </div>
    <div class="case-layout shell">
      <aside class="case-toc">
        <p class="eyebrow">In this study</p>
        <nav aria-label="On this page">
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
        </nav>
        <a class="text-link" href="mailto:resume@chynes.org">
          Discuss this work <Arrow diagonal />
        </a>
      </aside>
      <div class="case-body">
        {id === 'readmission-prediction' && <ResultsFigure id="case-results" />}
        {(id === 'multi-llm' || id === 'signal-assistant') && (
          <figure class="case-diagram">
            <SystemDiagram kind={id === 'multi-llm' ? 'multi' : 'signal'} id="case-system" />
            <figcaption>
              {id === 'multi-llm'
                ? 'Concurrent generation and judged selection, with explicit fallbacks.'
                : 'Message transport, per-chat state, and local inference.'}
            </figcaption>
          </figure>
        )}
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
  <section class="next-project shell">
    <p class="eyebrow">Keep exploring</p>
    <a href={`/projects/${next.id}/`}>
      <h2>{next.data.shortTitle}</h2>
      <Arrow />
    </a>
  </section>
</Base>

<style>
  .demo-note,
  .artifact-note {
    margin-top: 16px;
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--muted);
  }
</style>
