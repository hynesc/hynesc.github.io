{
  "name": "christopher-hynes-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "validate": "node scripts/validate-site.mjs",
    "test": "playwright test",
    "social": "node scripts/generate-social.mjs",
    "screenshots": "node scripts/capture-preview.mjs",
    "format": "prettier --write src scripts tests *.mjs *.ts *.json .github/workflows/*.yml README.md",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
